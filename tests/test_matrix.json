      "static": false,
      "requires_docker": false,
      "requires_running_stack": false,
      "timeout_seconds": 180,
      "junit_output": "test-results/junit/agent.xml",
      "isolation_reason": "Agent imports top-level modules from CODE/Agent and must not inherit RAG or Simulation app modules.",
      "environment": {
        "SIMULATION_BASE_URL": "http://simulation:7000",
        "RAG_BASE_URL": "http://rag:7001",
        "AGENT_BASE_URL": "http://agent:9090",
        "GATEWAY_BASE_URL": "http://gateway:8888",
        "LLM_BASE_URL": "",
        "LLM_REQUIRED": "false"
