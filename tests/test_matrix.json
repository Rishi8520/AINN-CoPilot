{
  "version": 1,
  "suites": [
    {
      "id": "root_contracts",
      "description": "Root service contracts and deployment contract tests.",
      "working_directory": ".",
      "runner": "pytest",
      "args": [
        "tests/test_service_contracts.py",
        "tests/test_root_deployment_contracts.py",
        "tests/test_matrix_contracts.py",
        "tests/test_demo_scenario_contracts.py",
        "tests/test_demo_runner.py"
      ],
      "pythonpath": [],
      "category": "contract",
      "required": true,
      "fast": true,
      "static": false,
      "requires_docker": false,
      "requires_running_stack": false,
      "timeout_seconds": 120,
      "junit_output": "test-results/junit/root_contracts.xml",
      "isolation_reason": "Root tests do not import component app packages but validate the matrix isolation rules.",
      "environment": {},
      "forbidden_network": true,
      "separate_process": true,
      "import_collision_risk": "low"
    },
    {
      "id": "agent",
      "description": "Agent, Gateway, tool contract, and UI configuration tests with mocked downstream services.",
