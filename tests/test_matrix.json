      "junit_output": "test-results/junit/rag_core.xml",
      "isolation_reason": "CODE/RAG owns a top-level app package that collides with CODE/Simulation/app.",
      "environment": {
        "RAG_PROFILE": "quickstart",
        "RAG_AUTO_INGEST": "false",
        "RAG_SYNTHESIS_BACKEND": "deterministic",
