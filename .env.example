# TelcoMind single-node quickstart defaults.
# Copying this file is optional; docker compose has the same safe defaults.

COMPOSE_PROJECT_NAME=telcomind-quickstart

# Browser/host-facing ports. Change these only if a host port is occupied.
HOST_SIMULATION_PORT=7000
HOST_RAG_PORT=7001
HOST_VLLM_PORT=8080
HOST_GATEWAY_PORT=8888
HOST_AGENT_PORT=9090
HOST_UI_PORT=8501

# Compatibility aliases retained for component-level Compose files.
SIMULATION_PORT=7000
RAG_PORT=7001
VLLM_PORT=8080
GATEWAY_PORT=8888
AGENT_PORT=9090
UI_PORT=8501

# Container-internal service URLs are normally set by docker-compose.yml.
SIMULATION_BASE_URL=http://simulation:7000
RAG_BASE_URL=http://rag:7001
AGENT_BASE_URL=http://agent:9090
GATEWAY_BASE_URL=http://gateway:8888

# Default Simulation profile: recorded replay, not live Simu5G.
SIMULATION_DEFAULT_MODE=replay
SIMULATION_REPLAY_FIXTURE=phase_bootstrap_normal
SIMULATION_REPLAY_STRICT_CHECKSUMS=true
SIMULATION_LIVE_ENABLED=false

# Default RAG profile: lexical quickstart, no Chroma build or PDF ingestion.
RAG_PROFILE=quickstart
RAG_QUICKSTART_CORPUS_PATH=quickstart/corpus.jsonl
RAG_QUICKSTART_TOP_K=5
RAG_FULL_INDEX_PATH=/tmp/chroma-disabled
RAG_AUTO_INGEST=false
RAG_STRICT_PROVENANCE=true
RAG_DEVICE=cpu

# Default synthesis profile: deterministic, no model download and no LLM URL.
RAG_SYNTHESIS_BACKEND=deterministic
LLM_BASE_URL=
VLLM_BASE_URL=
LLM_ENDPOINT_URL=
LLM_PROVIDER=openai_compatible
LLM_MODEL=
LLM_REQUIRED=false
LLM_FALLBACK_TO_DETERMINISTIC=true
LLM_CONNECT_TIMEOUT_SECONDS=3
LLM_READ_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0
LLM_ENABLED=false

# Optional advanced LLM/vLLM settings. Leave empty for the default quickstart.
# VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Service timeout controls.
HEALTH_PROBE_TIMEOUT_SECONDS=4
STARTUP_PROBE_RETRIES=5
STARTUP_PROBE_DELAY_SECONDS=3
AGENT_REQUEST_TIMEOUT_SECONDS=60
UI_REQUEST_TIMEOUT_SECONDS=180
