# AINN-CoPilot / TelcoMind canonical service configuration.
# Copy to CODE/.env for local component development. Do not commit real .env files.

# Future single Docker network service DNS names. Batch 7 will provide the root compose.
SIMULATION_BASE_URL=http://simulation:7000
RAG_BASE_URL=http://rag:7001
VLLM_BASE_URL=http://vllm:8080
GATEWAY_BASE_URL=http://gateway:8888
AGENT_BASE_URL=http://agent:9090

# Native-host equivalents for running services directly on this machine:
# SIMULATION_BASE_URL=http://localhost:7000
# RAG_BASE_URL=http://localhost:7001
# VLLM_BASE_URL=http://localhost:8080
# GATEWAY_BASE_URL=http://localhost:8888
# AGENT_BASE_URL=http://localhost:9090

SIMULATION_PORT=7000
RAG_PORT=7001
VLLM_PORT=8080
GATEWAY_PORT=8888
AGENT_PORT=9090
UI_PORT=8501

SIMULATION_DEFAULT_MODE=replay
SIMULATION_REPLAY_FIXTURE=phase_bootstrap_normal
SIMULATION_REPLAY_STRICT_CHECKSUMS=true
SIMULATION_LIVE_ENABLED=false

# Backward-compatible aliases still read by older component code or OPEA images.
SIM_SERVICE_URL=http://simulation:7000
RAG_SERVICE_URL=http://rag:7001
LLM_ENDPOINT_URL=
AGENT_ENDPOINT=http://agent:9090
GATEWAY_URL=http://gateway:8888

LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_ENGINE=vllm
LLM_ENABLED=false
MAX_NEW_TOKENS=256

EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
CHROMA_DIR=/data/chroma
COLLECTION_NAME=telcomind_knowledge
RAG_PROFILE=quickstart
RAG_QUICKSTART_CORPUS_PATH=quickstart/corpus.jsonl
RAG_QUICKSTART_TOP_K=5
RAG_FULL_INDEX_PATH=/data/chroma
RAG_AUTO_INGEST=false
RAG_STRICT_PROVENANCE=true
TOP_K=5
RERANK_TOP_K=4
RAG_DEVICE=cpu

AGENT_STRATEGY=react_llama
RECURSION_LIMIT=15
WITH_MEMORY=true

SIM_HEALTH_PATH=/health
RAG_HEALTH_PATH=/health
AGENT_HEALTH_PATH=/v1/health_check
HEALTH_PROBE_TIMEOUT_SECONDS=4
STARTUP_PROBE_RETRIES=5
STARTUP_PROBE_DELAY_SECONDS=6
UI_REQUEST_TIMEOUT_SECONDS=180
