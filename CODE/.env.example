# ─────────────────────────────────────────────────────────────────
# AINN-CoPilot — Agent Layer Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# ── Host Machine ─────────────────────────────────────────────────
# Your local LAN IP (not 127.0.0.1 — Docker containers can't reach localhost)
# Run: hostname -I | awk '{print $1}'
HOST_IP=192.168.x.x

# ── LLM (hosted on Teammate 2's machine) ─────────────────────────
# vLLM OpenAI-compatible endpoint served by Member 2
LLM_ENDPOINT_URL=http://<TEAMMATE2_IP>:8080
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_PORT=8080
RAG_PORT=7000
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
CHROMA_DIR=/data/chroma
COLLECTION_NAME=telcomind_knowledge
TOP_K=8
RERANK_TOP_K=4
# Optional: set to "cuda" on Member 2 if torch sees the RTX 5070 Ti correctly.
# Keep "auto" if unsure.
RAG_DEVICE=auto

#No need to create, created by Memeber 3
HF_TOKEN=your_huggingface_token_here

# ── Simulation Service (Member 1) ────────────────────────────────
SIM_SERVICE_URL=http://localhost:8888

# ── RAG Retrieval Service (Member 2) ─────────────────────────────
RAG_SERVICE_URL=http://localhost:8889

# ── Redis Vector DB ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
INDEX_NAME=ainn_3gpp

# ── OPEA Agent ───────────────────────────────────────────────────
AGENT_PORT=9090
AGENT_STRATEGY=react_llama
RECURSION_LIMIT=15
WITH_MEMORY=true

# ── Streamlit UI ─────────────────────────────────────────────────
AGENT_URL=http://localhost:9090
UI_PORT=8501