FROM python:3.11.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN groupadd --system telcomind && useradd --system --gid telcomind --home-dir /app telcomind

COPY CODE/Simulation/requirements.quickstart.txt ./requirements.quickstart.txt
RUN pip install --no-cache-dir -r requirements.quickstart.txt

COPY --chown=telcomind:telcomind CODE/Simulation/app ./app
COPY --chown=telcomind:telcomind CODE/Simulation/fixtures ./fixtures

USER telcomind

EXPOSE 7000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "7000"]
