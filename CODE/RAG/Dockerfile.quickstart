FROM python:3.11.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN groupadd --system telcomind && useradd --system --gid telcomind --home-dir /app telcomind

COPY CODE/RAG/requirements.quickstart.txt ./requirements.quickstart.txt
RUN pip install --no-cache-dir -r requirements.quickstart.txt

COPY --chown=telcomind:telcomind CODE/RAG/app ./app
COPY --chown=telcomind:telcomind CODE/RAG/quickstart ./quickstart
COPY --chown=telcomind:telcomind CODE/RAG/knowledge_base ./knowledge_base

USER telcomind

EXPOSE 7001

CMD ["uvicorn", "app.rag_service:app", "--host", "0.0.0.0", "--port", "7001"]
